# Default provider selected when a request omits "provider".
# Must match one of the providers enabled below, or startup will fail.
LLM_DEFAULT_PROVIDER=LMSTUDIO

# LM Studio (local OpenAI-compatible server) — default provider
LMSTUDIO_ENABLED=true
# For Rancher Desktop: use your Mac's LAN IP (host.docker.internal is not reachable).
# For Docker Desktop: http://host.docker.internal:1234/v1 works.
LMSTUDIO_BASE_URL=http://192.168.64.1:1234/v1
LMSTUDIO_DEFAULT_MODEL=openai/gpt-oss-20b
LMSTUDIO_API_KEY=lm-studio

# Cloud providers — off by default, enable per request
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=

OPENAI_ENABLED=false
OPENAI_API_KEY=

BEDROCK_ENABLED=false
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Jira integration (optional — only needed for inputType=JIRA)
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Coding agent (M2) — sandboxed Docker execution for autonomous code generation
CODING_MAX_TOKENS=200000
CODING_MAX_ITERATIONS=20
CODING_MAX_DURATION=15m
CODING_CONTAINER_IMAGE=eclipse-temurin:21-jdk
CODING_CONTAINER_MEMORY=2g
CODING_CONTAINER_CPU=2.0
CODING_DEFAULT_REPO_URL=
CODING_DEFAULT_BASE_REF=main
CODING_TEST_COMMAND=./mvnw -q test

# GitHub integration (M3) — PR creation
GITHUB_ENABLED=false
GITHUB_AUTH_MODE=pat
GITHUB_TOKEN=
# For auth-mode=app, set these instead:
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
GITHUB_BRANCH_PREFIX=agentic/
GITHUB_COMMIT_AUTHOR_NAME=Agentic SDLC
GITHUB_COMMIT_AUTHOR_EMAIL=agentic-sdlc@agenticdev.com
